{
  "name": "Life Dashboard",
  "short_name": "Dashboard",
  "description": "Your personal life management tool — tasks, ideas, projects, lists",
  "start_url": "/Life-Dashboard/",
  "scope": "/Life-Dashboard/",
  "display": "standalone",
  "background_color": "#eef1f5",
  "theme_color": "#eef1f5",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icons/icon-192.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/Life-Dashboard/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
